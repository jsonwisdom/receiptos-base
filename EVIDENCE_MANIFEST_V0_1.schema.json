{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jsonwisdom/receiptos-base/blob/main/EVIDENCE_MANIFEST_V0_1.schema.json",
  "title": "Evidence Manifest V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "manifest_id", "entries"],
  "properties": {
    "version": { "const": "0.1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "byte_length", "mime", "role", "canonical"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["core_evidence", "hash_sidecar", "metadata", "transcript", "dataset", "other"]
        },
        "canonical": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "hash_sidecar" } },
            "required": ["role"]
          },
          "then": { "properties": { "canonical": { "const": false } } }
        }
      ]
    }
  }
}
