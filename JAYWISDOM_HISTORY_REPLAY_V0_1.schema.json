{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jsonwisdom/receiptos-base/blob/main/JAYWISDOM_HISTORY_REPLAY_V0_1.schema.json",
  "title": "JAYWISDOM History Replay V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fact",
    "evidence",
    "rule",
    "authority",
    "action",
    "outcome",
    "semantic_validation",
    "audit_verified"
  ],
  "properties": {
    "version": { "const": "0.1" },
    "fact": { "type": "object" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "citation_ids"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "citation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/manifest_entry_id" }
        }
      }
    },
    "rule": { "type": "object" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_created", "contract_seal"],
      "properties": {
        "authority_created": { "type": "boolean" },
        "contract_seal": { "enum": ["ABSENT", "PRESENT"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "contract_seal": { "const": "ABSENT" } },
            "required": ["contract_seal"]
          },
          "then": { "properties": { "authority_created": { "const": false } } }
        }
      ]
    },
    "action": { "type": "object" },
    "outcome": { "type": "object" },
    "quantitative_fields": {
      "type": "array",
      "items": { "$ref": "#/definitions/quantitative_field" }
    },
    "semantic_validation": { "enum": ["PASS", "PENDING", "FAIL"] },
    "audit_verified": { "type": "boolean" }
  },
  "definitions": {
    "manifest_entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "quantitative_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit"],
      "properties": {
        "status": { "enum": ["observed", "not_attempted", "not_observed"] },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["not_attempted", "not_observed"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "value": { "const": 0 },
              "unit": { "const": "none" }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "semantic_validation": { "enum": ["PENDING", "FAIL"] } },
        "required": ["semantic_validation"]
      },
      "then": { "properties": { "audit_verified": { "const": false } } }
    },
    {
      "if": {
        "properties": { "audit_verified": { "const": true } },
        "required": ["audit_verified"]
      },
      "then": { "properties": { "semantic_validation": { "const": "PASS" } } }
    }
  ]
}
