{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receiptos-base.example/receipt-schema/contentcoin/v1.1/resolver/provenance-resolution-batch.schema.json",
  "title": "PROVENANCE_CHAIN_RESOLVER_V0_1 resolution batch",
  "type": "object",
  "required": [
    "resolver_version",
    "resolution_id",
    "observed_at",
    "network",
    "contract_address",
    "seal_version",
    "authority",
    "receipts"
  ],
  "properties": {
    "resolver_version": { "const": "PROVENANCE_CHAIN_RESOLVER_V0_1" },
    "resolution_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "network": { "const": "base" },
    "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "seal_version": { "const": "READOUT_SEAL_V1_1" },
    "authority": { "const": false },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_type",
          "observed_at",
          "network",
          "contract_address",
          "source",
          "authority",
          "releases"
        ],
        "properties": {
          "receipt_type": {
            "enum": [
              "DEPLOY_TX_RECEIPT_V1",
              "FACTORY_TRACE_RECEIPT_V1",
              "IMPLEMENTATION_RECEIPT_V1",
              "METADATA_RECEIPT_V1",
              "POOL_RECEIPT_V1",
              "HOLDER_SNAPSHOT_RECEIPT_V1",
              "ANCHOR_MATCH_RECEIPT_V1",
              "PROVENANCE_CONFIDENCE_RECEIPT_V1"
            ]
          },
          "observed_at": { "type": "string", "format": "date-time" },
          "network": { "const": "base" },
          "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "source": { "type": "string", "minLength": 1 },
          "authority": { "const": false },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "value"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "value": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
